{
  "name": "writing-assistant-context",
  "displayName": "Writing Assistant Context",
  "description": "Reports open markdown files and cursor positions to the writing-assistant service.",
  "version": "0.1.0",
  "publisher": "bobbigmac",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Other"],
  "activationEvents": ["onLanguage:markdown"],
  "main": "./src/extension.js",
  "contributes": {
    "configuration": {
 "title": "Writing Assistant",
      "properties": {
        "writingAssistant.serviceUrl": {
          "type": "string",
          "default": "http://127.0.0.1:3848",
          "description": "URL of the writing-assistant service"
        },
        "writingAssistant.cursorDebounceMs": {
          "type": "number",
          "default": 500,
          "description": "Debounce time for cursor position updates (ms)"
        }
      }
    }
  }
}
